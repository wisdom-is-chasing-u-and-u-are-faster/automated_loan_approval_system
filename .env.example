# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
SECRET_KEY=ssms-enterprise-jwt-dev-secret-key-2026 # pragma: allowlist secret

# Stripe Configuration (Payment Gateway & Webhook Signature)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_placeholder # pragma: allowlist secret
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_placeholder # pragma: allowlist secret
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key_placeholder

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
