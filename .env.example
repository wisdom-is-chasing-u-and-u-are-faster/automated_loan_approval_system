# ==============================================================================
# Enterprise Automatic Loan Approval System (ALAS) - Environment Configuration
# ==============================================================================

# Application Server
PORT=8000
HOST=0.0.0.0
APP_ENV=development
DEBUG=True

# Database Configuration (SQLite for local / PostgreSQL for staging & production)
DATABASE_URL=sqlite:///./alas.db
DB_POOL_SIZE=10

# Security & OAuth2 / OIDC Token Configuration
SECRET_KEY=alas-dev-secret-key-3815-super-secure-token-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional Redis Cache / Idempotency Service
REDIS_URL=redis://localhost:6379/0

# Client API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
