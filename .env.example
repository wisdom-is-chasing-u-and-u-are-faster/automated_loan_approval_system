DATABASE_URL=sqlite:///./ssms.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ssms_db # pragma: allowlist secret
DB_POOL_SIZE=10

# Cache & Redis Message Broker (BullMQ / Distributed Lock)
